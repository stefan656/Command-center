# Copy to .env.local for local `vercel dev`, or set these directly in the
# Vercel project's Environment Variables settings. Never commit real values.

# Required — Claude API key used by /api/viki-respond.js
ANTHROPIC_API_KEY=

# Optional — Zapier MCP server for live, read-only Follow Up Boss lookups.
# Set these up in Zapier's MCP server product (mcp.zapier.com), enabling
# ONLY read/search Follow Up Boss actions (e.g. "Find a Contact",
# "Make API GET Request"). Do NOT enable any create/update/delete action
# on that server — this phase is strictly read-only.
# Without these two set, VIKI still answers questions, just without live CRM data.
ZAPIER_MCP_URL=
ZAPIER_MCP_TOKEN=

# Optional — override the default read-only tool allowlist enforced in
# api/viki-respond.js. Comma-separated MCP tool names, exactly as your
# Zapier MCP server exposes them. Only ever list read/search tools here.
# ZAPIER_MCP_ALLOWED_TOOLS=follow_up_boss_find_a_contact,follow_up_boss_make_api_get_request
