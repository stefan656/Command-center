# Copy to .env.local for local `vercel dev`, or set these directly in the
# Vercel project's Environment Variables settings. Never commit real values.

# Required — Claude API key used by /api/viki-respond.js
ANTHROPIC_API_KEY=

# Required only if your key is "identity-linked" (tied to a user who belongs
# to more than one workspace) — Anthropic's API will 400 with a message
# telling you this is needed if so, e.g.:
#   "anthropic-workspace-id is required when authenticating with an
#    identity-linked API key; send the id of the workspace this request
#    acts in."
# Find the ID (looks like wrkspc_...) in the Anthropic Console under
# Settings -> Workspaces, or in that workspace's URL.
ANTHROPIC_WORKSPACE_ID=

# Optional — Zapier MCP server for live, read-only Follow Up Boss lookups.
# Get this from your Zapier MCP server's config page (mcp.zapier.com) — the
# server/connect URL it gives you to paste into any MCP client. That URL
# already has an auth token baked into its query string (?token=...), so
# ZAPIER_MCP_URL is normally the ONLY one of these two you need to set —
# leave ZAPIER_MCP_TOKEN blank unless Zapier separately gives you a bearer
# token to send in an Authorization header.
#
# On the Zapier server itself, make sure ONLY read/search Follow Up Boss
# actions are enabled (e.g. "Find a Contact", "Make API GET Request") — do
# NOT enable any create/update/delete action there; this phase is strictly
# read-only, and api/viki-respond.js's own allowlist is the second layer of
# enforcement, not the only one.
# Without ZAPIER_MCP_URL set, VIKI still answers questions, just without live CRM data.
# Treat this URL as a secret — it carries live account access. Never commit
# a real value here or paste it anywhere public.
ZAPIER_MCP_URL=
ZAPIER_MCP_TOKEN=

# Optional — override the default read-only tool allowlist enforced in
# api/viki-respond.js. Comma-separated MCP tool names, exactly as your
# Zapier MCP server exposes them. Only ever list read/search tools here.
# ZAPIER_MCP_ALLOWED_TOOLS=follow_up_boss_find_a_contact,follow_up_boss_make_api_get_request
